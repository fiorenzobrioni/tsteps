<?xml version="1.0" encoding="utf-8"?>
<!-- Default locale = English: automatic fallback for unsupported device languages.
     Rule of the fake-editor design (inherited from tweather): "code" (JSON keys,
     filenames, terminal errors, // comments) stays English everywhere; only chrome,
     accessibility text and user-facing DATA values are localized. -->
<resources>
    <string name="app_name" translatable="false">tsteps</string>

    <!-- Bottom navigation -->
    <string name="nav_editor">Editor</string>
    <string name="nav_log">Log</string>
    <string name="nav_stats">Stats</string>
    <string name="nav_settings">Settings</string>

    <!-- Chrome / status bars -->
    <string name="status_last_commit">Last commit: %1$s</string>
    <string name="status_commits">%1$d commits</string>
    <string name="status_days">%1$d days</string>

    <!-- Accessibility -->
    <string name="cd_grant_activity_recognition">Grant permission to read the step counter</string>
    <string name="cd_start_track">Start a tracked walk</string>
    <string name="cd_toggle_session">Expand or collapse the %1$s session</string>
    <string name="cd_pause_track">Pause the session</string>
    <string name="cd_resume_track">Resume the session</string>
    <string name="cd_stop_track">Stop the session</string>
    <string name="cd_confirm_stop_track">Confirm stopping the session</string>

    <!-- Live tracking: channel name is chrome (localized); the notification body
         is terminal output built in code (English by design) -->
    <string name="notif_channel_tracking">Live tracking</string>
    <string name="cd_change_setting">Change %1$s</string>
    <string name="cd_open_link">Open %1$s website</string>
    <string name="cd_reset_settings">Reset all settings to defaults</string>
    <string name="cd_confirm_reset">Confirm settings reset</string>
    <string name="cd_cancel_edit">Cancel editing</string>
    <string name="cd_toggle_commit">Expand or collapse the %1$s commit</string>
    <string name="cd_open_commit">Open the %1$s commit in the log</string>

    <!-- README.md (day tab): a README is prose, so unlike JSON keys it is FULLY
         localized, headings included. Markdown punctuation is added in code. -->
    <string name="readme_h_today">Today</string>
    <string name="readme_h_status">Status</string>
    <string name="readme_h_walks">Walks</string>
    <string name="readme_h_week">Week</string>
    <string name="readme_summary">**%1$s steps** \u00b7 %2$s \u00b7 %3$d min</string>
    <string name="readme_kcal">Active calories: %1$s kcal (estimate)</string>
    <string name="readme_goal_reached">\u2713 Goal reached: %1$s of %2$s steps</string>
    <string name="readme_goal_progress">%1$s of %2$s steps \u00b7 %3$s to go</string>
    <string name="readme_goal_none">No goal set.</string>
    <string name="readme_streak">Current streak: %1$d days</string>
    <string name="readme_warn_no_sensor">\u26a0\ufe0f No step sensor on this device</string>
    <string name="readme_warn_no_permission">\u26a0\ufe0f Missing permission to read the step counter</string>
    <string name="readme_t_start">Start</string>
    <string name="readme_t_min">Min</string>
    <string name="readme_t_steps">Steps</string>
    <string name="readme_t_distance">Distance</string>
    <string name="readme_t_active">Active</string>
    <string name="readme_t_day">Day</string>
    <string name="readme_footer">Computed on device \u00b7 %1$d committed days</string>
</resources>
