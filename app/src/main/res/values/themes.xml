<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Tsteps" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@color/window_background</item>
        <item name="android:navigationBarColor">@color/window_background</item>
        <!-- Dark-only app: system bar icons must stay light even when the phone is
             in light mode, or they vanish into the Obsidian background. Set here as
             well as in MainActivity so the window is right before Compose starts. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- One body line of the home widget's terminal transcript (colors bound at
         render time via spans). Shared by the medium/large layouts.

         fontFamily is the SYSTEM monospace, not @font/jetbrains_mono_*, and this
         is the one place in the app where that rule is broken: since the June 2021
         patch (CVE-2021-0567) the launcher inflates widget layouts in a restricted
         context that silently drops font resources — an @font/ reference would
         fall back to Roboto, a proportional face (tweather's documented
         deviation, inherited). -->
    <style name="WidgetBodyLine" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <!-- One colored fragment of the static picker preview (colors inline there). -->
    <style name="WidgetPreviewText" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- Cold-start splash: Obsidian background + the { footprints } brand mark, then
         hands over to Theme.Tsteps (installSplashScreen() in MainActivity). -->
    <style name="Theme.Tsteps.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tsteps</item>
        <!-- Theme.SplashScreen is not a Theme.Tsteps child: repeat the light-bar
             opt-out so the splash window doesn't flash dark status bar icons. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
