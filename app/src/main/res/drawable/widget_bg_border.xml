<?xml version="1.0" encoding="utf-8"?>
<!-- The 1px terminal frame, Obsidian by default (see widget_bg_fill for why the
     color is baked in). Re-tinted with the theme's border color at render time and
     kept opaque even when the fill is faded, so the window edge stays crisp.

     The transparent <solid> is load-bearing, not decoration: GradientDrawable.draw()
     substitutes an OPAQUE fill (`mFillPaint.setColor(mAlpha << 24)`) whenever a color
     filter is set on a shape that declares no solid color. Without this line the
     frame paints a filled rectangle over the fill layer and the opacity setting has
     no visible effect at all. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="#30363D" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
