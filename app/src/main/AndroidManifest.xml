<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Step counter sampling (Fase 2); minSdk 33 = single runtime-request path.
         tsteps has no INTERNET permission at all: the data never leaves the device. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Manual tracking (Fase 6): the app's ONLY service, alive exactly as long
         as a `$ tsteps track` session runs — never for passive counting. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- The tracking notification is the service's visible face; declared here,
         requested at runtime in Fase 9 (until then it may stay hidden — the
         service runs regardless). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Health Connect interop (Fase 12): on-device IPC to the system's HC
         module — a Jetpack client, no Play Services, still no INTERNET. All
         three are inert until the user enables health_connect.sync (default
         off) and grants them on the HC screen. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tsteps">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Tsteps.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Health Connect asks apps to explain their data use: this intent
                 lands on the settings tab, where the health_connect section IS
                 the explanation (tsteps has no website to point to — no network). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ routes the HC privacy-policy link through this alias. -->
        <activity-alias
            android:name=".ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!-- The live-tracking process (Fase 6). health type: step counting during
             an explicitly started fitness session, backed by ACTIVITY_RECOGNITION. -->
        <service
            android:name=".tracking.TrackingService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Home widget (Fase 10). exported=false: the system delivers APPWIDGET_*
             regardless, and it keeps our refresh action private (tweather). -->
        <receiver
            android:name=".widget.TstepsWidgetProvider"
            android:exported="false"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_tsteps_info" />
        </receiver>
    </application>

</manifest>
